# Copier en .env (ignore par git) pour tester la persistance Supabase en local.
# Project Settings -> API sur app.supabase.com.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Cle privilegiee (nouveau format "sb_secret_..." ou ancien JWT service_role) --
# jamais la cle publishable/anon, jamais exposee au frontend mobile.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
