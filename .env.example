# Copier en .env (ignore par git) pour tester la persistance Supabase en local.
# Project Settings -> API sur app.supabase.com.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Cle privilegiee (nouveau format "sb_secret_..." ou ancien JWT service_role) --
# jamais la cle publishable/anon, jamais exposee au frontend mobile.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Code d'acces de l'API (voir api/auth.py). Vide ou absent : API ouverte.
NUITCLAIRE_API_TOKEN=
# Notifications push (voir README, "Alertes push") : python scripts/gen_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@example.org
# Secret envoye par Vercel Cron a GET /api/cron/alerts.
CRON_SECRET=
